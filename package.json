{
  "name": "nestjs-zario",
  "version": "1.1.0",
  "description": "NestJS custom logger service for Zario.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check src tests",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "zario": "^0.9.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@types/node": "^20.0.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "zario": "file:../../zario",
    "@types/bun": "^1.3.0",
    "@biomejs/biome": "^2.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-dami/nestjs-zario.git"
  }
}
